#!/bin/sh
set -eu
root=$(git rev-parse --show-toplevel)
while read -r local_ref local_sha remote_ref remote_sha; do
    test "$local_sha" = 0000000000000000000000000000000000000000 && continue
    # Do not assume the ref being pushed is the current checkout.
    test "$local_sha" = "$(git rev-parse HEAD)" || {
        echo 'Check out each pushed ref before publication' >&2; exit 1;
    }
    python3 "$root/scripts/check_proprietary.py" --history origin/main
done
