- **Concrete channel behavior:** @ref gige_mel::provider_detail::ImageChannelImpl "ImageChannelImpl"
  (@ref gige_mel::provider_detail::ImageChannelImpl::send(mel::NavigationReport) "ImageChannelImpl::send(NavigationReport)"),
  @ref gige_mel::provider_detail::StackedImageChannelImpl "StackedImageChannelImpl",
  @ref gige_mel::provider_detail::C2ChannelImpl "C2ChannelImpl"
  (@ref gige_mel::provider_detail::C2ChannelImpl::send(ir::ModeCmd) "C2ChannelImpl::send(ModeCmd)"),
  @ref gige_mel::provider_detail::HealthChannelImpl "HealthChannelImpl"
  (@ref gige_mel::provider_detail::HealthChannelImpl::registerMetadataCallback(std::function<void(ir::Channel&,const ir::SubsystemStatusResp*const)>) "HealthChannelImpl::registerMetadataCallback(SubsystemStatusResp)"),
  @ref gige_mel::provider_detail::SchedulingChannelImpl "SchedulingChannelImpl"
  (@ref gige_mel::provider_detail::SchedulingChannelImpl::exec(ir::IRSTStareTask) "SchedulingChannelImpl::exec(IRSTStareTask)",
  @ref gige_mel::provider_detail::SchedulingChannelImpl::exec(ir::AbortTask) "SchedulingChannelImpl::exec(AbortTask)").
